# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# CORS Configuration
# Set to frontend origin, e.g. https://talkspace.online (or multiple origins separated by commas)
ALLOWED_ORIGIN="https://talkspace.online"

# Database Connection
# Postgres URL (for docker / production): postgresql://talksy:talksy_secret@localhost:5432/talksy_db?schema=public
# SQLite fallback for local quick start: file:./dev.db
DATABASE_URL="file:./dev.db"

# Redis Connection (optional for local fallback mode, required for scaled pub/sub)
REDIS_URL="redis://localhost:6379"

# Object Storage / Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=10
PUBLIC_SERVER_URL="http://localhost:4000"
PUBLIC_WEB_URL="http://localhost:3000"

# Session Security
SESSION_SECRET="talksy-super-secret-key-change-in-production"

# Client Frontend Environment Variables (apps/web - Vite)
# Note: In production static site deployment, set these build-time environment variables in Render
VITE_API_BASE_URL="https://talkspace-server.onrender.com/api"
VITE_WS_URL="https://talkspace-server.onrender.com"

